#include <winver.h>

1 ICON "padmix.ico"
1 24 "padmix.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     PADMIX_V1,PADMIX_V2,PADMIX_V3,0
PRODUCTVERSION  PADMIX_V1,PADMIX_V2,PADMIX_V3,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "ra7bi"
            VALUE "FileDescription",  PADMIX_DESC
            VALUE "FileVersion",      PADMIX_VSTR
            VALUE "InternalName",     PADMIX_INTERNAL
            VALUE "LegalCopyright",   "Copyright (c) 2026 ra7bi. MIT License."
            VALUE "OriginalFilename", PADMIX_FILE
            VALUE "ProductName",      "PadMix"
            VALUE "ProductVersion",   PADMIX_VSTR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
